# Lines that begin with "##" are .env variables.
# To use them, remove the "##" for them to be used.
# For defaults, just leave them commented. Every single one is optional.


# Django Settings
## DJANGO_DEBUG=True
## SECRET_KEY=your-secret-key-here
## ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default)
## DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL Database (uncomment and configure if using PostgreSQL)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Email Configuration
## EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
## EMAIL_HOST=localhost
## EMAIL_PORT=25
## EMAIL_USE_TLS=False
## EMAIL_HOST_USER=
## EMAIL_HOST_PASSWORD=
## DEFAULT_FROM_EMAIL=webmaster@localhost

# Security (set these to False in production with HTTPS)
## SECURE_SSL_REDIRECT=False
## SESSION_COOKIE_SECURE=False
## CSRF_COOKIE_SECURE=False

# Debug Toolbar (development only)
## INTERNAL_IPS=127.0.0.1

# Custom Settings
## SITE_NAME="Sistema Académico"
## SITE_DESCRIPTION="Plataforma de gestión académica"
## DEFAULT_FROM_EMAIL="no-reply@example.com"